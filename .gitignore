# ── Dependencies ──
node_modules/
frontend/node_modules/

# ── Build output ──
frontend/dist/
dist/

# ── Environment & secrets (keep *.example tracked) ──
.env
**/.env
!**/.env.example

# ── Python runtime ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── SQLite local fallback (Neon is production DB) ──
*.db

# ── Graphify knowledge graph (regenerated via `graphify extract .`) ──
graphify-out/

# ── Large / downloaded geodata ──
data/dem/
*.tif
*.tiff
*.hgt
*.mp4

# ── Logs & caches ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ── OS & editors ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Local-only convenience scripts ──
*.local
*.bat
developing_way.md

# ── AI agent / IDE configs (not needed in production) ──
.agents/
.codex/
.cursor/
.cursorrules

# ── Prototypes & internal docs ──
stitch/
docs/
