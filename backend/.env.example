# GlacierGuard Backend Environment Configuration
# If DATABASE_URL is empty, SQLite (glacierguard.db) is used as automatic local fallback.
# For Neon PostgreSQL, use:
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Allowed CORS origins for frontend access
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather & Seismic API Endpoints (no API keys required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# Copernicus CDSE (ESA): Sentinel-2 optical imagery (Free at https://dataspace.copernicus.eu)
# Option A: Registered OAuth2 Client (User Profile -> OAuth Clients)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Option B: Free Copernicus CDSE Account Login
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
